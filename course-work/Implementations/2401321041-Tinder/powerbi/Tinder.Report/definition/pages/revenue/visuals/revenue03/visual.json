{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "revenue03",
  "position": {
    "x": 650,
    "y": 140,
    "z": 3,
    "width": 610,
    "height": 290,
    "tabOrder": 3
  },
  "visual": {
    "visualType": "donutChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimPaymentMethod"
                    }
                  },
                  "Property": "MethodName"
                }
              },
              "queryRef": "DimPaymentMethod.MethodName",
              "nativeQueryRef": "MethodName",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "FactPayments"
                    }
                  },
                  "Property": "Net Revenue"
                }
              },
              "queryRef": "FactPayments.Net Revenue",
              "nativeQueryRef": "Net Revenue"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Payment methods'"
                }
              }
            }
          }
        }
      ]
    }
  }
}